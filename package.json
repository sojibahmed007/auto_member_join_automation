{
  "name": "playwright-community-automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript Automation Suite for Backbenchers Academy Community CDN",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:debug": "playwright test --debug",
    "test:search": "playwright test tests/search-box-break.spec.ts",
    "test:search:headed": "playwright test tests/search-box-break.spec.ts --headed",
    "break:search": "npx tsx scripts/test-search-break.ts",
    "automate": "npx tsx scripts/run-smoke-automation.ts",
    "add-members": "npx tsx scripts/auto-add-members.ts"
  },
  "keywords": ["playwright", "typescript", "automation", "e2e-testing"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
